code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_lambert, specular_schlick_ggx;

uniform vec2 escala_vertice = vec2(2.000000, 2.000000);
uniform sampler2D tex_vtx_5;
uniform float volumen_suelo;
uniform float darness;
uniform vec2 escala_textura = vec2(2.000000, 2.000000);
uniform sampler2D tex_frg_2;
uniform float multiplicador_normal_map;
uniform float multiplicador_normal;



void vertex() {
// Input:2
	vec3 n_out2p0 = VERTEX;


// Input:3
	vec3 n_out3p0 = NORMAL;


// Input:9
	vec2 n_out9p0 = UV;


// Vector2Parameter:12
	vec2 n_out12p0 = escala_vertice;


// UVFunc:10
	vec2 n_in10p2 = vec2(0.00000, 0.00000);
	vec2 n_out10p0 = (UV - n_in10p2) * n_out12p0 + n_in10p2;


// VectorOp:11
	vec2 n_out11p0 = n_out9p0 * n_out10p0;


// Texture2D:5
	vec4 n_out5p0 = texture(tex_vtx_5, n_out11p0);
	float n_out5p1 = n_out5p0.r;


// FloatParameter:8
	float n_out8p0 = volumen_suelo;


// FloatOp:7
	float n_out7p0 = n_out5p1 * n_out8p0;


// VectorOp:6
	vec3 n_out6p0 = n_out3p0 * vec3(n_out7p0);


// VectorOp:4
	vec3 n_out4p0 = n_out2p0 + n_out6p0;


// Output:0
	VERTEX = n_out4p0;


}

void fragment() {
// FloatParameter:8
	float n_out8p0 = darness;


// Input:3
	vec2 n_out3p0 = UV;


// Vector2Parameter:6
	vec2 n_out6p0 = escala_textura;


// UVFunc:4
	vec2 n_in4p2 = vec2(0.00000, 0.00000);
	vec2 n_out4p0 = (UV - n_in4p2) * n_out6p0 + n_in4p2;


// VectorOp:5
	vec2 n_out5p0 = n_out3p0 * n_out4p0;


// Texture2D:2
	vec4 n_out2p0 = texture(tex_frg_2, n_out5p0);


// VectorOp:9
	vec3 n_out9p0 = vec3(n_out8p0) * vec3(n_out2p0.xyz);


// FloatParameter:12
	float n_out12p0 = multiplicador_normal_map;


// FloatParameter:10
	float n_out10p0 = multiplicador_normal;


// VectorOp:13
	vec3 n_out13p0 = vec3(n_out12p0) * vec3(n_out10p0);


// VectorOp:11
	vec3 n_out11p0 = vec3(n_out12p0) * vec3(n_out2p0.xyz);


// Output:0
	ALBEDO = n_out9p0;
	EMISSION = n_out13p0;
	AO = n_out11p0.x;


}
