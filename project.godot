; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="RunningArcher"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.5", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Progreso="*res://scripts/progreso.gd"
SignalLens="*res://addons/signal_lens/autoload/signal_lens_autoload.gd"

[debug]

settings/stdout/verbose_stdout=true

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/handheld/orientation=1

[editor_plugins]

enabled=PackedStringArray("res://addons/gkanban/plugin.cfg", "res://addons/signal_lens/plugin.cfg")

[filesystem]

import/blender/enabled=false

[input_devices]

pointing/emulate_touch_from_mouse=true

[layer_names]

3d_physics/layer_1="player"
3d_physics/layer_2="enemy"
3d_physics/layer_3="arrow"
3d_physics/layer_4="suelo"

[rendering]

textures/vram_compression/import_etc2_astc=true
